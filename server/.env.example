# Host LAN IPv4 address: replace this with the Docker host's actual address.
# This is the published host address, not the container's listen address.
NIIMBLUE_STORAGE_BIND_IP=192.168.1.100
NIIMBLUE_STORAGE_PUBLISH_PORT=8787

# Default user's token. Generate a dedicated token, then paste it after '=':
#   openssl rand -hex 32
# At least 24 non-whitespace ASCII characters. A user's devices share their token.
# Set this, NIIMBLUE_STORAGE_USERS, or both. Existing single-user data belongs to default.
NIIMBLUE_STORAGE_TOKEN=

# Optional JSON object: stable server-side user ID -> unique token.
# Generate a different token for every user. User IDs stay on the server;
# browsers enter only their own token. Empty default token allows users-only mode.
# NIIMBLUE_STORAGE_USERS='{"alice":"<alice-generated-token>","bob":"<bob-generated-token>"}'
NIIMBLUE_STORAGE_USERS=

# Exact origin of the WEB APP opened on your phone/computer, not the storage API.
# Include the scheme and any non-default port. No path or trailing slash.
# Multiple origins: https://labels.example.com,http://localhost:5173
NIIMBLUE_STORAGE_ORIGINS=https://labels.example.com
