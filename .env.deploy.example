# Copy to .env.deploy, then use: docker compose --env-file .env.deploy ...
# Docker host's LAN IPv4 address. Bind only the interface used by LAN devices.
NIIMBLUE_BIND_IP=192.168.1.100
# Address opened on phones/computers: an IP or LAN DNS name, without scheme/port/path.
# If using a name, configure your LAN DNS to resolve it to NIIMBLUE_BIND_IP.
NIIMBLUE_HOST=192.168.1.100
# One published port: plaintext HTTP redirects to HTTPS on this same port.
NIIMBLUE_HTTPS_PORT=443
# Target machine architecture: linux/amd64 (Intel/AMD) or linux/arm64 (ARM64).
NIIMBLUE_PLATFORM=linux/amd64

# Optional: store labels and Caddy state under ./data (see deployment guide).
# Image bundle / prebuilt images on Linux:
# COMPOSE_FILE=compose.yaml:compose.bind.yaml
# Source checkout (also load build definitions):
# COMPOSE_FILE=compose.yaml:compose.override.yaml:compose.bind.yaml

# Generate a token: openssl rand -hex 32
# At least 24 non-whitespace ASCII characters; never use the example placeholders.
# Set the default token, the per-user JSON below, or both.
NIIMBLUE_STORAGE_TOKEN=
# Each user needs a distinct token. Devices sharing a user use the same token.
# NIIMBLUE_STORAGE_USERS='{"alice":"<alice-generated-token>","bob":"<bob-generated-token>"}'
NIIMBLUE_STORAGE_USERS=
